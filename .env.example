# Copy this file to ".env" (same folder as run.py) and fill it in. ".env" is git-ignored; never commit real passwords.
# ADMIN_NOTIFY_EMAIL=your.real@gmail.com   (receives the admin's mails, e.g. the monthly report; login stays admin@gmail.com)
# Gmail: turn on 2-Step Verification, then create an "App password" at https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_FROM_NAME=Examination Portal
